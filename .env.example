# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# Paths (defaults are relative to the project root — override for custom locations)
DATA_DIR=./data
MODELS_DIR=./models/artefacts
INDEX_DIR=./rag/index
AUDIT_DB_PATH=./audit.db

# Groq API key — free tier; leave empty to use local fallback explanation
GROQ_API_KEY=

# RAG similarity threshold (0.0–1.0); commits below this score return "no match found"
SIMILARITY_THRESHOLD=0.75
# Create an API key at https://console.groq.com
