# .gitignore — PR Risk Scorer
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.python-version

# --- Environment secrets ---
.env

# --- Data & model artefacts (never commit large binaries) ---
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep
models/artefacts/
*.bin
*.pt
*.pth
*.pkl
*.joblib
*.onnx
*.zip
*.h5

# --- FAISS index ---
rag/index/

# --- SQLite audit log ---
audit.db
*.db

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Node / Dashboard ---
node_modules/
dashboard/dist/
dashboard/.next/
dashboard/node_modules/

# --- Jupyter ---
.ipynb_checkpoints/
Untitled*.ipynb

# --- PyInstaller ---
*.spec

# --- pytest / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- mypy ---
.mypy_cache/

# --- Scratch / planning files that should never be in the repo ---
Planing/
Planing.zip
pr-risk-scorer-package/
pr-risk-scorer-package.zip
work on db/
guide.html
codebert_best_model.zip
